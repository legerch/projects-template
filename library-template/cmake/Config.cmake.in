# Package configuration file based on project template repository: https://github.com/legerch/projects-template
## Template file version: 2026-11-27
## This file is used by "find_package(@PROJECT_NAME@)", it is generated by CMake when installing the library

@PACKAGE_INIT@

# Find public dependencies (needed by library public headers)
## Only public dependencies are needed, private ones are already linked into the shared library
include(CMakeFindDependencyMacro)

## Qt: only if library was built with it (value is empty for native libraries)
set(_qt_version_major "@QT_VERSION_MAJOR@")
if(_qt_version_major)
    find_dependency(Qt${_qt_version_major} COMPONENTS @PROJECT_QT_COMPONENTS@)
endif()

## Others: add here public dependencies (set in "PROJECT_LINKING_LIB_PUB"), private ones must not be added
### Example: find_dependency(nlohmann_json 3.11.3)

# Import library target ("@PROJECT_NAME@::@PROJECT_NAME@")
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components(@PROJECT_NAME@)
